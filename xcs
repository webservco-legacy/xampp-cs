# ================================================================================
#############
# VARIABLES #
#############

# define XAMPP installation directory
# edit the following line if your XAMPP is installed somewhere else
SERVERDIR="/opt/lampp/"
SERVERPATH=$SERVERDIR"lampp"

# ================================================================================
#############
# CONSTANTS #
#############

# program info
P_FILE=$(basename $0)
P_NAME="XAMPP CS"
P_VER="1.0.061001"
P_DESC="A simple bash script for controlling XAMPP for Linux"
P_AUTH_N="Radu Maier"
P_AUTH_E="oimoroiATgmailDOTcom"
P_AUTH_W="http://underbeat.evonet.ro"
P_COPY="Copyright (C) 2006 $P_AUTH_N"
P_FULL_NAME="$P_NAME version $P_VER $P_COPY GNU/GPL Licensed"

# user info
P_USER=$USER
P_USER_NOW=$(date +"%Y-%m-%d %H:%M:%S")

# ================================================================================
#############
# FUNCTIONS #
#############

#
# EXIT AND CONTIUNE FUNCTIONS
#

function exit_error 
{
# display error message and exit
    echo "$1" 1>&2
    exit 1
}

function exit_ok
{
# display thank you message and exit gracefully
    clear
    echo "--------------------------------------------------------------------------------"
    echo "                           Thanx for using $P_NAME!                            "
    echo "--------------------------------------------------------------------------------"
    exit 0
}

function su_root
{
# switch user to root
    echo "enter root password!"
}

function p_header
{
# header
    clear
    echo "--------------------------------------------------------------------------------"
    echo " $P_NAME, started by $P_USER on $P_USER_NOW"
    echo "--------------------------------------------------------------------------------"
    echo "                                                                                "
}

function p_header_m
{
    echo "--------------------------------------------------------------------------------"
    echo " $P_FULL_NAME "
    echo "--------------------------------------------------------------------------------"
    echo "                                                                                "
}

function p_logo
{
# xampp cs logo
        echo "        X     X    A    M     M PPPPPP  PPPPPP           CCCCC   SSSSS          "
        echo "         X   X    A A   MM   MM P     P P     P         C     C S     S         "
        echo "          X X    A   A  M M M M P     P P     P         C       S               "
        echo "           X    A     A M  M  M PPPPPP  PPPPPP          C        SSSSS          "
        echo "          X X   AAAAAAA M     M P       P               C             S         "
        echo "         X   X  A     A M     M P       P               C     C S     S         "
        echo "        X     X A     A M     M P       P                CCCCC   SSSSS          "
}

function p_footer
{
# footer
    echo "                                                                                "
    echo "--------------------------------------------------------------------------------"
    echo " done! | Press ENTER to continue                                                "
    echo "--------------------------------------------------------------------------------"
    read
    clear
}

function invalid_selection
{
# invalid selection
    p_header
    p_logo
    echo "                                                                                "
    echo "--------------------------------------------------------------------------------"
    echo "                                                                                "
    echo "                                                                                "
    echo "                                                                                "
    echo "                           NOT A VALID SELECTION!                               "
    echo "                                                                                "
    echo "                                                                                "
    echo "                                                                                "
    echo "                                                                                "
    echo "--------------------------------------------------------------------------------"
    echo " error | page 1/1 | Press ENTER to continue                                                "
    echo "--------------------------------------------------------------------------------"
    read
    clear
}

#
# EXECUTION CONDITIONS
#

function check_xampp
{
# check if XAMPP is installed
    if [ ! -e /opt/lampp/lampp ]; then
        clear
        p_header_m
        echo " Dear $USER,"
        echo "                                                                                "
        echo " I can't seem to find the XAMPP Server on your system."
        echo " Either it is not installed, or you have placed it"
        echo " somwhere other than your /opt directory"
        echo "                                                                                "
        echo " If XAMPP is indeed installed on your system,"
        echo " and it is in a directory other than /opt/lampp "
        echo " you need to  modify this script to let it know      "
        echo " where to find XAMPP on your machine."
        echo "                                                                                "
        echo " Please open the xcs script with a text editor and modify"
        echo " line 29 to reflect your XAMPP directory"
        echo "                                                                                "
        echo " Best regards,"
        echo "    $P_AUTH_N"
        echo "--------------------------------------------------------------------------------"
        exit_error "$P_NAME : error 01: xampp not installed"
fi
}

function check_user
{
# make sure you are not logged in as root
    clear
    if [ $(id -u) = "0" ]; then
        p_header
        echo " Dear $USER,"
        echo "                                                                                "
        echo " We, here at $P_NAME HQ, are strongly against"
        echo " operating the computer as the superuser!"
        echo "                                                                                "
        echo " So, please, log out and start $P_NAME as a normal user!"
        echo "                                                                                "
        echo " Best regards,"
        echo "    $P_AUTH_N"
        echo "--------------------------------------------------------------------------------"
        exit_error "$P_NAME : error 02: user logged in as root"
    fi
    echo "checking user!"
}

#
# ACTUAL EXECUTION
#

function xampp_start
{
# start the server
    p_header
    echo "Starting the server ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH start;exit"
    p_footer
}

function xampp_stop
{
# stop the server
    p_header
    echo "Stopping the server ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH stop;exit"
    p_footer
}

function xampp_restart
{
# restart server
    p_header
    echo "Restarting the server ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH restart;exit"
    p_footer
}

function xampp_check
{
# check server status
    p_header
    echo "Checking server status ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH status;exit"
    p_footer
}

function xampp_security
{
# perform security check
    p_header
    echo "Checking server security ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH security;exit"
    p_footer
}

function apache_start
{
# start Apache
    p_header
    echo "Starting Apache ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH startapache;exit"
    p_footer
}

function apache_stop
{
# stop Apache
    p_header
    echo "Stopping Apache ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH stopapache;exit"
    p_footer
}

function mysql_start
{
# start MySQL
    p_header
    echo "Starting MySQL ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH startmysql;exit"
    p_footer
}

function mysql_stop
{
# stop MySQL
    p_header
    echo "Stopping MySQL ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH stopmysql;exit"
    p_footer
}

function ftp_start
{
# start (and activate) ProFTPd
    p_header
    echo "Starting ProFTPd ..."
    echo "(Note: ProFTPd will remain activated when you restart XAMPP)"
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH startftp;exit"
    p_footer
}

function ftp_stop
{
# stop (and deactivate) ProFTPd
    p_header
    echo "Stopping ProFTPd ..."
    echo "(Note: ProFTPd will remain deactivated when you restart XAMPP)"
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH stopftp;exit"
    p_footer
}

function ssl_start
{
# start (and activate) SSL
    p_header
    echo "Starting SSL support for Apache ..."
    echo "(Note: SSL will remain activated when you restart XAMPP)"
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH startssl;exit"
    p_footer
}

function ssl_stop
{
# stop (and deactivate) SSL
    p_header
    echo "Stopping SSL support for Apache ..."
    echo "(Note: SSL will remain deactivated when you restart XAMPP)"
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH startftp;exit"
    p_footer
}

function php_check
{
# check php version
    p_header
    echo "Checking PHP version ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH phpstatus;exit"
    p_footer
}

function php_4
{
# select php4
    p_header
    echo "Switching to PHP 4 ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH php4;exit"
    p_footer
}

function php_5
{
# select php5
    p_header
    echo "Switching to PHP 5 ..."
    echo "                                                                                "
    echo -n "Enter ROOT "
    su -c "$SERVERPATH php5;exit"
    p_footer
}

