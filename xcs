#
# MENU
#

function main_menu
{
# main menu page 1
    selection=
    clear
    until [ "$selection" = "0" ]; do
        p_header_m
        p_logo
        echo "                                                                                "
        echo "                                                                                "
        echo "--------------------------------------------------------------------------------"
        echo "  [x] start server         APACHE     ProFTPd               PHP                 "
        echo "  [k] stop server          [1] start  [f] start (+ enable)  [p] check version   "
        echo "  [r] restart server       [2] stop   [g] stop (+ disable)  [4] select php4     "
        echo "  [c] server status                                         [5] select php5     "
        echo "  [s] server security      MySQL      SSL                                       "
        echo "                           [m] start  [v] start (+ enable)  [h] help            "
        echo "  [0] exit                 [q] stop   [w] stop (+ disable)  [a] about           "
        echo "--------------------------------------------------------------------------------"
        echo -e "\a main menu | page 1/1 | make a selection and press ENTER                      "
        echo "--------------------------------------------------------------------------------"
        read selection
        case $selection in
            x ) xampp_start;;
            k ) xampp_stop;;
            r ) xampp_restart;;
            c ) xampp_check;;
            s ) xampp_security;;
            1 ) apache_start;;
            2 ) apache_stop;;
            m ) mysql_start;;
            q ) mysql_stop;;
            f ) ftp_start;;
            g ) ftp_stop;;
            v ) ssl_start;;
            w ) ssl_stop;;
            p ) php_check;;
            4 ) php_4;;
            5 ) php_5;;
            h ) help_page;;
            a ) about_page;;
            0 ) exit_ok;;
            * ) invalid_selection
        esac
    done
}

# ================================================================================
#############
# EXECUTION #
#############

# first of all, check to see if you have XAMPP installed on your system
check_xampp

# make sure you are not logged in as root
check_user

# Menu or command line usage
# If options are given, execute them. Else, display the menu.
if [ "$1" != "" ]; then
    while [ "$1" != "" ]; do
        case $1 in
            -x | --start )    xampp_start
                            exit_ok
                            ;;
            -k | --stop )     xampp_stop
                            exit_ok
                            ;;
            -r | --restart )  xampp_restart
                            exit_ok
                            ;;
            -c | --check )    xampp_check
                            exit_ok
                            ;;
            -s | --security ) xampp_security
                            exit_ok
                            ;;
            -1 | --apachex )  apache_start
                            exit_ok
                            ;;
            -2 | --apachek )  apache_stop
                            exit_ok
                            ;;
            -m | --mysqlx )   mysql_start
                            exit_ok
                            ;;
            -q | --mysqlk )   mysql_stop
                            exit_ok
                            ;;
            -f | --ftpx )     ftp_start
                            exit_ok
                            ;;
            -g | --ftpk )     ftp_stop
                            exit_ok
                            ;;
            -v | --sslx )     ssl_start
                            exit_ok
                            ;;
            -w | --sslk )     ssl_stop
                            exit_ok
                            ;;
            -p | --php )      php_check
                            exit_ok
                            ;;
            -4 | --php4 )     php_4
                            exit_ok
                            ;;
            -5 | --php5 )     php_5
                            exit_ok
                            ;;
            -h | --help )     help_page
                            exit_ok
                            ;;
            -a | --about )    about_page
                            exit_ok
                            ;;
            * )             main_menu
        esac
    done
else
    main_menu
fi