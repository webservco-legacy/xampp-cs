    echo "             (you will be asked for your root password when needed)             "
    echo "                                                                                "
    echo "                                                                                "
    echo " USAGE:                                                                         "
    echo "  xcs [-option(short)]   example: xcs -h                                        "
    echo " or                                                                             "
    echo "  xcs [--option(long)]   example: xcs --help                                    "
    echo "                                                                                "
    echo " with no option, or with a non valid one, the menu is displayed                 "
    echo "                                                                                "
    echo " OPTIONS                                                                        "
    echo "  -x | --start     start the server                                             "
    echo "  -k | --stop      stop the server                                              "
    echo "  -r | --restart   restart the server                                           "
